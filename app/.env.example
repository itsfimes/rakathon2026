# Public build-time configuration only. Never place credentials in VITE_*.
# Unset also means backend. Restart dev/rebuild after changing this value.
VITE_DATA_MODE=backend
# Optional public same-origin read API opt-in; absent means unconfigured (no requests).
# VITE_BACKEND_API_BASE=/api/v1
# Server-only key FILE path is passed to the Vite Node process, never VITE_*.
# RAKATHON_BACKEND_PROXY_KEY_FILE must point outside app/ to an owner-only 0600 file.
