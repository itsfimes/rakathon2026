{
  "name": "atlas-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=26" },
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_DATA_MODE=mock vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "NODE_ENV=test vitest run",
    "build": "tsc --noEmit && NODE_ENV=production vite build",
    "build:mock": "VITE_DATA_MODE=mock npm run build -- --outDir dist-mock",
    "verify:no-mocks": "node scripts/verify-artifacts.mjs dist backend",
    "verify:mock": "node scripts/verify-artifacts.mjs dist-mock mock",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run verify:no-mocks"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
