# Non-secret IRIS FHIR settings (no credential values in this file).
# Keep real credentials in a private 0600 file, e.g.:
#   printf 'RAKATHON_IRIS_FHIR_BASE_URL=%s\n' "https://iris.racek.xyz/fhir/r4" > iris.env
#   printf 'RAKATHON_IRIS_FHIR_USER=%s\n' "FHIR_USER" >> iris.env
#   printf 'RAKATHON_IRIS_FHIR_PASSWORD=%s\n' "$FHIR_PASSWORD" >> iris.env
#   printf 'RAKATHON_IRIS_FHIR_VERIFY_TLS=1\nRAKATHON_IRIS_FHIR_ALLOW_DIRECT=1\n' >> iris.env
#   chmod 600 iris.env
RAKATHON_IRIS_FHIR_BASE_URL=https://iris.racek.xyz/fhir/r4
RAKATHON_IRIS_FHIR_USER=FHIR_USER_PLACEHOLDER
RAKATHON_IRIS_FHIR_PASSWORD=changeme
RAKATHON_IRIS_FHIR_VERIFY_TLS=1
RAKATHON_IRIS_FHIR_ALLOW_DIRECT=1
